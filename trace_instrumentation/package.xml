<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trace_instrumentation</name>
  <version>0.0.0</version>
  <description>Minimal LTTng tracing launch action and trace analysis tooling for wrapping ROS 2 launch files</description>
  <maintainer email="aramachandra@gritt.ai">aramachandra</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>ros2trace</exec_depend>
  <exec_depend>tracetools_launch</exec_depend>
  <exec_depend>tracetools_trace</exec_depend>
  <exec_depend>python3-lttngust</exec_depend>
  <exec_depend>python3-bt2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
