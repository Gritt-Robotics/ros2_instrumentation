<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mock_trace_py</name>
  <version>0.0.0</version>
  <description>Python publisher and subscriber nodes for trace-analyzer validation</description>
  <maintainer email="aramachandra@gritt.ai">aramachandra</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>trace_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>trace_instrumentation</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <exec_depend>ros2trace</exec_depend>
  <exec_depend>tracetools_launch</exec_depend>
  <exec_depend>tracetools_trace</exec_depend>
  <exec_depend>python3-lttngust</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
